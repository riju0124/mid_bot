# Create a bot application at https://discord.com/developers/applications
DISCORD_TOKEN=
CLIENT_ID=

# Optional: register commands in one server for instant development updates.
# Leave blank to register commands globally (global propagation may take time).
GUILD_ID=

SERVER_NAME=Midtown RP
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_RESTART_TIMES=08:00
STATUS_CHANNEL_ID=1554672512556732566
MANAGER_ROLE_IDS=1554467538291916820,1564884642757345362

# Public server address for live FiveM status. The bot reads info.json and
# dynamic.json from this address. Enter a public host:port, e.g. 203.0.113.10:30120.
FIVEM_SERVER_ADDRESS=51.79.162.71:28348
FIVEM_CONNECT_ADDRESS=51.79.162.71:28348
STATUS_REFRESH_SECONDS=30

# Pterodactyl Client API settings. Make a client API key with only the
# permissions needed for this server (power restart/start/stop and resource read).
PTERODACTYL_PANEL_URL=
PTERODACTYL_SERVER_ID=
PTERODACTYL_API_KEY=

# Legacy alias: you can use this instead of FIVEM_SERVER_ADDRESS. It may be the
# base URL or the full /info.json URL.
FIVEM_STATUS_URL=

# Optional POST endpoint for a hosting-panel bridge that can restart your server.
# It receives JSON: { "event": "restart", "guildId": "...", "serverName": "...", "scheduledAt": "..." }
FIVEM_RESTART_WEBHOOK_URL=
FIVEM_RESTART_WEBHOOK_TOKEN=
